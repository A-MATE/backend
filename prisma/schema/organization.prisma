enum OrganizationType {
  COMPANY
  CLUB
  SCHOOL
  NON_PROFIT
}

model Contact {
  id            String         @id @default(uuid())
  name          String
  email         String
  phone         String?
  organizations Organization[] @relation("contact_organizations")
}

model Organization {
  id        String           @id @default(uuid())
  name      String           @unique
  type      OrganizationType
  address   String
  logo      String?
  teams     Team[]
  users     User[]
  contactId String?
  contact   Contact?         @relation("contact_organizations", fields: [contactId], references: [id])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  isActive  Boolean          @default(true)
  deletedAt DateTime?

  @@map("organizations")
}
