generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  COMPANY
  CLUB
  SCHOOL
  NON_PROFIT
}

model Contact {
  id            String         @id @default(uuid())
  name          String
  email         String
  phone         String?
  organizations Organization[] @relation("contact_organizations")

  @@map("contact")
}

model Organization {
  id        String           @id @default(uuid())
  name      String           @unique
  type      OrganizationType
  address   String
  logo      String?
  teams     Team[]
  users     User[]
  contactId String?
  contact   Contact?         @relation("contact_organizations", fields: [contactId], references: [id])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  isActive  Boolean          @default(true)
  deletedAt DateTime?

  @@map("organization")
}

enum TeamAgeCategory {
  U6
  U9
  U13
  U15
  U17
  U19
  SENIOR
  VETERAN
}

enum TeamGender {
  MALE
  FEMALE
  MIXED
}

model Team {
  id             String           @id @default(uuid())
  name           String
  description    String?
  logo           String?
  ageGroup       TeamAgeCategory?
  gender         TeamGender?
  users          User[]
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  isActive       Boolean          @default(true)
  deletedAt      DateTime?
  Match          Match[]

  @@map("team")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPERADMIN
}

model User {
  id             String       @id @default(uuid())
  email          String
  password       String
  role           UserRole
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  teamId         String?
  team           Team?        @relation(fields: [teamId], references: [id])
  firstName      String?
  lastName       String?
  birthDate      DateTime?
  bio            String?
  avatar         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  isActive       Boolean      @default(true)

  @@unique([email, teamId])
  @@map("user")
}

model Match {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  date      DateTime
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("match")
}
